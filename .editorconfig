root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml,json}]
indent_size = 2

[{composer.json,ext_emconf.php}]
indent_style = tab

[*.{html,xlf,xml}]
indent_size = 4

[*.typoscript]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
