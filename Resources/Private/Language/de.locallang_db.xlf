    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:google_for_jobs/Resources/Private/Language/locallang_db.xlf" product-name="google_for_jobs">
        <header/>
        <body>
            <trans-unit id="tx_google_for_jobs_job.name" approved="yes">
                <source>Jobs (Google for Jobs)</source>
                <target>Stellenangebote (Google for Jobs)</target>
            </trans-unit>
            <trans-unit id="tx_google_for_jobs_job.description" approved="yes">
                <source>Lists job postings and renders the detail view including JobPosting structured data for Google.</source>
                <target>Listet Stellenangebote und gibt die Detailansicht inklusive strukturierter JobPosting-Daten für Google aus.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job" approved="yes">
                <source>Job</source>
                <target>Stellenangebot</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.dates" approved="yes">
                <source>Dates</source>
                <target>Datum</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.organization" approved="yes">
                <source>Hiring organization</source>
                <target>Arbeitgeber</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.remote" approved="yes">
                <source>Remote work</source>
                <target>Remote-Arbeit</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.salary" approved="yes">
                <source>Base salary</source>
                <target>Grundgehalt</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.title" approved="yes">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.title.description" approved="yes">
                <source>Output as "title". Only the job title, e.g. "Software Engineer" or "Barista". Do not include job codes, addresses, dates, salaries or the company name, and avoid excessive special characters.</source>
                <target>Wird als „title“ ausgegeben. Nur die Stellenbezeichnung, z. B. „Software Engineer“ oder „Barista“. Keine Stellencodes, Adressen, Daten, Gehälter oder Firmennamen und möglichst keine Sonderzeichen.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.alternative_title" approved="yes">
                <source>Alternative title</source>
                <target>Alternativer Titel</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.alternative_title.description" approved="yes">
                <source>Shown in the frontend list instead of the title. Not part of the structured data.</source>
                <target>Wird in der Frontend-Liste statt des Titels angezeigt. Nicht Teil der strukturierten Daten.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.path_segment" approved="yes">
                <source>URL segment</source>
                <target>URL-Segment</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.description" approved="yes">
                <source>Description</source>
                <target>Beschreibung</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.description.description" approved="yes">
                <source>Required, output as "description" (HTML). Complete description of the job: responsibilities, qualifications, skills, working hours, education and experience requirements. Must differ from the title. Google recognises paragraphs and lists.</source>
                <target>Pflichtangabe, wird als „description“ (HTML) ausgegeben. Vollständige Beschreibung der Stelle: Aufgaben, Qualifikationen, Fähigkeiten, Arbeitszeiten, Anforderungen an Ausbildung und Berufserfahrung. Muss sich vom Titel unterscheiden. Google wertet Absätze und Listen aus.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type" approved="yes">
                <source>Employment type</source>
                <target>Beschäftigungsart</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type.description" approved="yes">
                <source>Output as "employmentType". One or more of FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER.</source>
                <target>Wird als „employmentType“ ausgegeben. Ein oder mehrere Werte aus FULL_TIME, PART_TIME, CONTRACTOR, TEMPORARY, INTERN, VOLUNTEER, PER_DIEM, OTHER.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_full_time" approved="yes">
                <source>Full time</source>
                <target>Vollzeit</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_part_time" approved="yes">
                <source>Part time</source>
                <target>Teilzeit</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_contractor" approved="yes">
                <source>Contractor</source>
                <target>Freie Mitarbeit</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_temporary" approved="yes">
                <source>Temporary</source>
                <target>Befristet</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_intern" approved="yes">
                <source>Intern</source>
                <target>Praktikum</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_volunteer" approved="yes">
                <source>Volunteer</source>
                <target>Ehrenamt</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_per_diem" approved="yes">
                <source>Per diem</source>
                <target>Tageweise</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.employment_type_other" approved="yes">
                <source>Other</source>
                <target>Sonstiges</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.date_posted" approved="yes">
                <source>Date posted</source>
                <target>Veröffentlicht am</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.date_posted.description" approved="yes">
                <source>Required, output as "datePosted" (ISO 8601). The original date on which the employer posted the job.</source>
                <target>Pflichtangabe, wird als „datePosted“ (ISO 8601) ausgegeben. Das ursprüngliche Datum, an dem der Arbeitgeber die Stelle veröffentlicht hat.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.valid_through" approved="yes">
                <source>Valid through</source>
                <target>Gültig bis</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.valid_through.description" approved="yes">
                <source>Output as "validThrough" (ISO 8601, end of the selected day). Required by Google if the posting has an expiry date. Leave empty if the job has no deadline. Expired jobs are hidden in lists by default.</source>
                <target>Wird als „validThrough“ (ISO 8601, Ende des gewählten Tages) ausgegeben. Laut Google Pflicht, wenn die Anzeige ein Ablaufdatum hat. Leer lassen, wenn es keine Frist gibt. Abgelaufene Stellen werden in Listen standardmäßig ausgeblendet.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_name" approved="yes">
                <source>Organization name</source>
                <target>Name des Arbeitgebers</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_name.description" approved="yes">
                <source>Required, output as "hiringOrganization.name". Name of the company offering the job, not a specific branch. Use "confidential" for anonymous postings.</source>
                <target>Pflichtangabe, wird als „hiringOrganization.name“ ausgegeben. Name des Unternehmens, nicht einer einzelnen Niederlassung. Für anonyme Anzeigen „confidential“ eintragen.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_website" approved="yes">
                <source>Organization website</source>
                <target>Website des Arbeitgebers</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_website.description" approved="yes">
                <source>Output as "hiringOrganization.sameAs" (absolute URL).</source>
                <target>Wird als „hiringOrganization.sameAs“ (absolute URL) ausgegeben.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_logo_url" approved="yes">
                <source>Organization logo</source>
                <target>Logo des Arbeitgebers</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.hiring_organization_logo_url.description" approved="yes">
                <source>Output as "hiringOrganization.logo" (absolute URL). Select a file or enter an external URL. Only needed if the logo should differ from the one Google already shows for the organization.</source>
                <target>Wird als „hiringOrganization.logo“ (absolute URL) ausgegeben. Datei auswählen oder externe URL eintragen. Nur nötig, wenn ein anderes Logo als das bei Google hinterlegte erscheinen soll.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.job_locations" approved="yes">
                <source>Job locations</source>
                <target>Arbeitsorte</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.job_locations.description" approved="yes">
                <source>Output as "jobLocation". Required unless the job is 100% remote. Each location needs at least a country.</source>
                <target>Wird als „jobLocation“ ausgegeben. Pflicht, außer bei 100 % Remote-Stellen. Jeder Arbeitsort braucht mindestens ein Land.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.job_location_type" approved="yes">
                <source>Fully remote (TELECOMMUTE)</source>
                <target>Vollständig remote (TELECOMMUTE)</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.job_location_type.description" approved="yes">
                <source>Outputs "jobLocationType": "TELECOMMUTE". Only for jobs that are 100% remote, not for occasional home office. This must also be clear from the description.</source>
                <target>Gibt „jobLocationType“: „TELECOMMUTE“ aus. Nur für Stellen, die zu 100 % remote sind, nicht für gelegentliches Homeoffice. Das muss auch aus der Beschreibung hervorgehen.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.applicant_location_requirements" approved="yes">
                <source>Allowed countries for remote work</source>
                <target>Zulässige Länder für Remote-Arbeit</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.applicant_location_requirements.description" approved="yes">
                <source>Output as "applicantLocationRequirements". Comma-separated list of countries from which the remote job can be done, e.g. "DE, AT". At least one country is required for remote jobs.</source>
                <target>Wird als „applicantLocationRequirements“ ausgegeben. Kommagetrennte Liste der Länder, aus denen die Remote-Stelle ausgeübt werden kann, z. B. „DE, AT“. Bei Remote-Stellen ist mindestens ein Land Pflicht.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_enable" approved="yes">
                <source>Specify base salary</source>
                <target>Grundgehalt angeben</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_enable.description" approved="yes">
                <source>Outputs "baseSalary" only if enabled. Only the employer may state the salary, and it must match the salary shown on the page.</source>
                <target>Gibt „baseSalary“ nur aus, wenn aktiviert. Nur der Arbeitgeber darf das Gehalt angeben, und es muss mit dem Gehalt auf der Seite übereinstimmen.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_currency" approved="yes">
                <source>Currency</source>
                <target>Währung</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_currency.description" approved="yes">
                <source>Output as "baseSalary.currency". ISO 4217 code, e.g. EUR.</source>
                <target>Wird als „baseSalary.currency“ ausgegeben. ISO-4217-Code, z. B. EUR.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_text" approved="yes">
                <source>Per</source>
                <target>Pro</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_text.description" approved="yes">
                <source>Output as "baseSalary.value.unitText": HOUR, DAY, WEEK, MONTH or YEAR.</source>
                <target>Wird als „baseSalary.value.unitText“ ausgegeben: HOUR, DAY, WEEK, MONTH oder YEAR.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_hour" approved="yes">
                <source>Hour</source>
                <target>Stunde</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_day" approved="yes">
                <source>Day</source>
                <target>Tag</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_week" approved="yes">
                <source>Week</source>
                <target>Woche</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_month" approved="yes">
                <source>Month</source>
                <target>Monat</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_unit_year" approved="yes">
                <source>Year</source>
                <target>Jahr</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_value" approved="yes">
                <source>Exact salary</source>
                <target>Genaues Gehalt</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_value.description" approved="yes">
                <source>Output as "baseSalary.value.value". Actual base salary as stated by the employer, not an estimate. Leave at 0 if you specify a range.</source>
                <target>Wird als „baseSalary.value.value“ ausgegeben. Tatsächliches Grundgehalt laut Arbeitgeber, keine Schätzung. Bei einer Gehaltsspanne auf 0 lassen.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_min_value" approved="yes">
                <source>Salary from</source>
                <target>Gehalt von</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_min_value.description" approved="yes">
                <source>Output as "baseSalary.value.minValue". Use "from" and "to" for a salary range instead of an exact salary.</source>
                <target>Wird als „baseSalary.value.minValue“ ausgegeben. „Von“ und „bis“ für eine Gehaltsspanne statt eines genauen Gehalts verwenden.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_max_value" approved="yes">
                <source>Salary to</source>
                <target>Gehalt bis</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.base_salary_max_value.description" approved="yes">
                <source>Output as "baseSalary.value.maxValue".</source>
                <target>Wird als „baseSalary.value.maxValue“ ausgegeben.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.application" approved="yes">
                <source>Application</source>
                <target>Bewerbung</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.identifier" approved="yes">
                <source>Reference number</source>
                <target>Referenznummer</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.identifier.description" approved="yes">
                <source>Output as "identifier.value". The organization's unique identifier for the job. If empty, the record uid is used.</source>
                <target>Wird als „identifier.value“ ausgegeben. Eindeutige Kennung der Stelle beim Arbeitgeber. Ist das Feld leer, wird die Datensatz-ID verwendet.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.direct_apply" approved="yes">
                <source>Direct application</source>
                <target>Direktbewerbung</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.direct_apply.description" approved="yes">
                <source>Output as "directApply". "Yes" means candidates can apply on the page of this job with a short and simple process, without being sent elsewhere.</source>
                <target>Wird als „directApply“ ausgegeben. „Ja“ bedeutet: Bewerbende können sich auf der Seite dieser Stelle mit einem kurzen, einfachen Ablauf bewerben, ohne weitergeleitet zu werden.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.direct_apply.unspecified" approved="yes">
                <source>Not specified</source>
                <target>Keine Angabe</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.direct_apply.yes" approved="yes">
                <source>Yes</source>
                <target>Ja</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.direct_apply.no" approved="yes">
                <source>No</source>
                <target>Nein</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.requirements" approved="yes">
                <source>Requirements</source>
                <target>Anforderungen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.palette.requirements.description" approved="yes">
                <source>These properties are in beta at Google and may not be shown in all regions.</source>
                <target>Diese Angaben sind bei Google in der Beta-Phase und werden eventuell nicht in allen Regionen angezeigt.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements" approved="yes">
                <source>Education requirements</source>
                <target>Bildungsanforderungen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.description" approved="yes">
                <source>Output as "educationRequirements" with "credentialCategory". Select "No requirements" if no specific education is needed.</source>
                <target>Wird als „educationRequirements“ mit „credentialCategory“ ausgegeben. „Keine Anforderungen“ wählen, wenn keine bestimmte Ausbildung nötig ist.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.no_requirements" approved="yes">
                <source>No requirements</source>
                <target>Keine Anforderungen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.high_school" approved="yes">
                <source>High school</source>
                <target>Schulabschluss</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.associate_degree" approved="yes">
                <source>Associate degree</source>
                <target>Berufsausbildung / Kurzstudium</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.bachelor_degree" approved="yes">
                <source>Bachelor degree</source>
                <target>Bachelor</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.professional_certificate" approved="yes">
                <source>Professional certificate</source>
                <target>Berufszertifikat</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.education_requirements.postgraduate_degree" approved="yes">
                <source>Postgraduate degree</source>
                <target>Master / Promotion</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.experience_months" approved="yes">
                <source>Experience (months)</source>
                <target>Berufserfahrung (Monate)</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.experience_months.description" approved="yes">
                <source>Output as "experienceRequirements.monthsOfExperience". Enter 0 if no experience is required, leave empty if not specified.</source>
                <target>Wird als „experienceRequirements.monthsOfExperience“ ausgegeben. 0 eintragen, wenn keine Erfahrung nötig ist; leer lassen, wenn keine Angabe gemacht werden soll.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.experience_in_place_of_education" approved="yes">
                <source>Experience may replace education</source>
                <target>Erfahrung ersetzt Ausbildung</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.experience_in_place_of_education.description" approved="yes">
                <source>Output as "experienceInPlaceOfEducation". Only output if both education and experience requirements are set.</source>
                <target>Wird als „experienceInPlaceOfEducation“ ausgegeben. Nur wirksam, wenn Bildungs- und Erfahrungsanforderungen gesetzt sind.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.fal_media" approved="yes">
                <source>Media</source>
                <target>Medien</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.fal_media.add" approved="yes">
                <source>Add media file</source>
                <target>Mediendatei hinzufügen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.fal_related_files" approved="yes">
                <source>Related files</source>
                <target>Zugehörige Dateien</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.fal_related_files.add" approved="yes">
                <source>Add file</source>
                <target>Datei hinzufügen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.category" approved="yes">
                <source>Category (text)</source>
                <target>Kategorie (Text)</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.category.description" approved="yes">
                <source>Free text, shown in the frontend only. Use system categories for filtering lists.</source>
                <target>Freitext, nur für die Frontend-Ausgabe. Zum Filtern von Listen die Systemkategorien verwenden.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_job.notes" approved="yes">
                <source>Internal notes</source>
                <target>Interne Notizen</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation" approved="yes">
                <source>Job location</source>
                <target>Arbeitsort</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.street_address" approved="yes">
                <source>Street and number</source>
                <target>Straße und Hausnummer</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.street_address.description" approved="yes">
                <source>Output as "address.streetAddress".</source>
                <target>Wird als „address.streetAddress“ ausgegeben.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.postal_code" approved="yes">
                <source>Postal code</source>
                <target>Postleitzahl</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.city" approved="yes">
                <source>City</source>
                <target>Ort</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.region" approved="yes">
                <source>Region</source>
                <target>Region</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.region.description" approved="yes">
                <source>Output as "address.addressRegion", e.g. the federal state.</source>
                <target>Wird als „address.addressRegion“ ausgegeben, z. B. das Bundesland.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.country" approved="yes">
                <source>Country</source>
                <target>Land</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.country.description" approved="yes">
                <source>Required, output as "address.addressCountry". Two-letter ISO 3166-1 code, e.g. DE.</source>
                <target>Pflichtangabe, wird als „address.addressCountry“ ausgegeben. Zweistelliger ISO-3166-1-Code, z. B. DE.</target>
            </trans-unit>
            <trans-unit id="tx_googleforjobs_domain_model_joblocation.jobs" approved="yes">
                <source>Used by jobs</source>
                <target>Verwendet von Stellen</target>
            </trans-unit>
