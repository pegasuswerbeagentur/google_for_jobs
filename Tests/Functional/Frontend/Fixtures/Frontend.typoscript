page = PAGE
page.10 = CONTENT
page.10 {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=0
    }
}

tt_content = CASE
tt_content {
    key.field = CType
    googleforjobs_job = EXTBASEPLUGIN
    googleforjobs_job {
        extensionName = GoogleForJobs
        pluginName = Job
    }
}

config {
    admPanel = 0
    debug = 0
}
