plugin.tx_googleforjobs_job {
    view {
        templateRootPaths.0 = EXT:google_for_jobs/Resources/Private/Templates/
        partialRootPaths.0 = EXT:google_for_jobs/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:google_for_jobs/Resources/Private/Layouts/
    }

    settings {
        job {
            renderDetailTemplate = 1
            hideExpired = 1
            setPageTitle = 1
        }
    }
}

config.pageTitleProviders {
    googleForJobs {
        provider = Pegasus\GoogleForJobs\PageTitle\JobPageTitleProvider
        before = record, seo
    }
}
